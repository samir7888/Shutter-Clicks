# Captions work with NO key at all (on-device matching).
# Add ONE key below to get AI-written captions that read the actual photo.

# Recommended: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternatives
GROQ_API_KEY=
XAI_API_KEY=

# If you set more than one key, choose which to use: gemini | groq | xai
# LLM_PROVIDER=gemini

# Model names change often. Override here if one is retired.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=qwen/qwen3.6-27b
# XAI_MODEL=grok-4
